post_install() {
  cat <<'NOTE'

  AI Kit installed. To finish:

    aikit doctor                                   check the prerequisites
    aikit setup                                    install the Omarchy entries
    systemctl --user enable --now aikit-sync.timer start syncing

  Omarchy bar widget (richer than the "command" entry):
    omarchy plugin add https://github.com/macarchy/omarchy-aikit.git --enable

NOTE
}

post_upgrade() {
  systemctl --user daemon-reload 2>/dev/null || true
}
