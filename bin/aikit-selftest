#!/bin/bash
# ---------------------------------------------------------------------------
# aikit-selftest — joue les parcours d'AI Kit sur un bac à sable.
#
# Aucun réseau, aucune fenêtre, aucune session tmux : les commandes du bureau
# (omarchy-menu-select / -input, omarchy-launch-tui, notify-send, aikit-sync)
# sont remplacées par des bouchons. Le bouchon du menu respecte le contrat de
# omarchy-menu-select : il rend "<libellé>\t<sous-titre>", jamais la clé — ce
# qui vérifie la table de correspondance plutôt que de la contourner.
#
#   aikit-selftest          joue tout
#   aikit-selftest -v       montre les menus traversés
# ---------------------------------------------------------------------------
set -uo pipefail

VERBOSE=${1:-}
# Ressources : celles du dépôt d'abord (utile en CI), sinon l'installation
SELF_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)
SHARE=${AIKIT_SHARE_SRC:-}
for d in "$SHARE" "$SELF_DIR/../share" "$HOME/.local/share/aikit" /usr/share/aikit; do
  [[ -n $d && -f $d/rows.py ]] && { SHARE=$(cd -- "$d" && pwd); break; }
done
[[ -f $SHARE/rows.py ]] || { echo "aikit-selftest: ressources introuvables" >&2; exit 1; }
AIKIT_BIN=${AIKIT_BIN:-$SELF_DIR/aikit}
PASS=0 FAIL=0

sandbox=$(mktemp -d) || exit 1
[[ -n ${AIKIT_KEEP:-} ]] || trap 'rm -rf "$sandbox"' EXIT

# --- bac à sable ------------------------------------------------------------
mkdir -p "$sandbox"/{bin,share,data,cache,repos}
ln -s "$SHARE/rows.py" "$SHARE/i18n.sh" "$SHARE/strings.json" "$sandbox/share/"

mkrepo() { # mkrepo <chemin relatif> <owner/name|->
  local dir="$sandbox/repos/$1"
  mkdir -p "$dir"
  git -C "$dir" init -q 2>/dev/null
  [[ $2 == - ]] || git -C "$dir" remote add origin "https://github.com/$2.git"
  touch -d "$3" "$dir/.git"
}
mkrepo "alpha"            "acme/alpha"        "2026-08-26 12:00"
mkrepo "beta project"     "acme/beta"         "2026-08-25 12:00"   # espace dans le nom
mkrepo "gamma · delta"    "acme/gamma"        "2026-08-24 12:00"   # le séparateur des sous-titres
mkrepo "local-only"       -                   "2026-08-23 12:00"   # pas de remote GitHub
mkrepo "dup/alpha"        "other/alpha"       "2026-08-22 12:00"   # même nom de dossier, autre propriétaire

python3 - "$sandbox/data/aikit.db" "$sandbox/repos" <<'PY'
import sqlite3, sys, time
con = sqlite3.connect(sys.argv[1])
con.executescript(open('/dev/stdin').read() if False else """
CREATE TABLE repos (nwo TEXT PRIMARY KEY, owner TEXT, name TEXT, stars INTEGER, open_issues INTEGER,
                    open_prs INTEGER, pushed_at TEXT, synced_at INTEGER, local_path TEXT);
CREATE TABLE inbox (kind TEXT, nwo TEXT, number INTEGER, title TEXT, draft INTEGER, ci TEXT,
                    updated_at TEXT, PRIMARY KEY (kind, nwo, number));
CREATE TABLE tracked (nwo TEXT PRIMARY KEY, path TEXT, last_used INTEGER, synced_at INTEGER);
CREATE TABLE issues (nwo TEXT, number INTEGER, title TEXT, labels TEXT, planned INTEGER,
                     assigned INTEGER, updated_at TEXT, PRIMARY KEY (nwo, number));
CREATE TABLE prs (nwo TEXT, number INTEGER, title TEXT, labels TEXT, draft INTEGER, ci TEXT,
                  conflicting INTEGER, updated_at TEXT, PRIMARY KEY (nwo, number));
CREATE TABLE meta (key TEXT PRIMARY KEY, value TEXT);
""")
now = int(time.time())
root = sys.argv[2]
con.executemany("INSERT INTO repos VALUES (?,?,?,?,?,?,?,?,?)", [
    ("acme/alpha", "acme", "alpha", 5, 2, 1, "2026-08-26T10:00:00Z", now, root + "/alpha"),
    ("acme/beta",  "acme", "beta", 90, 7, 0, "2026-08-20T10:00:00Z", now, root + "/beta project"),
    ("acme/gamma", "acme", "gamma", 0, 40, 3, "2026-08-24T10:00:00Z", now, root + "/gamma · delta"),
    ("acme/remote-only", "acme", "remote", 0, 1, 1, "2026-08-26T10:00:00Z", now, ""),
])
con.executemany("INSERT INTO inbox VALUES (?,?,?,?,?,?,?)", [
    ("failing",  "acme/alpha", 77, "#111 fix the thing", 0, "fail", "2026-08-26T10:00:00Z"),
    ("assigned", "acme/beta", 5, "do the needful", 0, "", "2026-08-25T10:00:00Z"),
    ("mine",     "acme/remote-only", 9, "no clone here", 0, "", "2026-08-26T10:00:00Z"),
])
con.execute("INSERT INTO tracked VALUES ('acme/alpha', '', ?, ?)", (now, now))
con.executemany("INSERT INTO issues VALUES (?,?,?,?,?,?,?)", [
    # le titre commence par un numéro : piège pour qui lirait le libellé
    ("acme/alpha", 12, "#999 crash on startup", '["effort: small"]', 1, 0, "2026-08-26T10:00:00Z"),
    ("acme/alpha", 34, "unplanned idea", '[]', 0, 0, "2026-08-25T10:00:00Z"),
])
con.executemany("INSERT INTO prs VALUES (?,?,?,?,?,?,?,?)", [
    ("acme/alpha", 77, "#111 fix the thing", '[]', 0, "fail", 0, "2026-08-26T10:00:00Z"),
])
con.commit()
PY

# --- bouchons ---------------------------------------------------------------
cat > "$sandbox/bin/omarchy-menu-select" <<'STUB'
#!/bin/bash
# Rend "<libellé>\t<sous-titre>" comme le vrai outil. La ligne choisie vient de
# $PICKS : "match:<texte>" (sous-chaîne du libellé) ou "index:<n>".
prompt="$1"; shift
rows=(); while (($#)); do [[ $1 == "--" ]] && break; rows+=("$1"); shift; done
[[ -n ${TRACE:-} ]] && { echo "MENU|$prompt|${#rows[@]}" >> "$TRACE"; printf '%s\n' "${rows[@]}" >> "$TRACE"; }
n=$(cat "$PICKS.n" 2>/dev/null || echo 0); echo $((n + 1)) > "$PICKS.n"
pick=$(sed -n "$((n + 1))p" "$PICKS")
[[ -z $pick ]] && exit 1
chosen=""
case "$pick" in
  index:*) chosen="${rows[${pick#index:}]}" ;;
  match:*) for r in "${rows[@]}"; do [[ $r == *"${pick#match:}"* ]] && { chosen="$r"; break; }; done ;;
  cancel)  exit 1 ;;
esac
[[ -z $chosen ]] && { echo "stub: aucune ligne ne correspond à « $pick » dans « $prompt »" >&2; exit 1; }
printf '%s\n' "${chosen#*$'\t'}"      # on retire le glyphe, on garde libellé + sous-titre
STUB
cat > "$sandbox/bin/omarchy-menu-input" <<'STUB'
#!/bin/bash
[[ -n ${TRACE:-} ]] && echo "INPUT|$1" >> "$TRACE"
n=$(cat "$PICKS.n" 2>/dev/null || echo 0); echo $((n + 1)) > "$PICKS.n"
sed -n "$((n + 1))p" "$PICKS"
STUB
cat > "$sandbox/bin/omarchy-launch-tui" <<'STUB'
#!/bin/bash
printf 'LAUNCH|%s\n' "$*"
STUB
printf '#!/bin/bash\nprintf "WEBAPP|%%s\\n" "$*"\n' > "$sandbox/bin/omarchy-launch-or-focus-webapp"
printf '#!/bin/bash\nprintf "ATTACH|%%s\\n" "$*"\n' > "$sandbox/bin/omarchy-launch-or-focus-tui"
# doctor ne doit ni toucher le réseau ni dépendre de la machine : gh et claude
# répondent « tout va bien » sans rien vérifier.
printf '#!/bin/bash\nexit 0\n' > "$sandbox/bin/gh"
# le vrai `claude --help` liste ses flags : doctor y cherche ceux qu'on passe
printf '#!/bin/bash\necho "--dangerously-skip-permissions --worktree"\n' > "$sandbox/bin/claude"
cat > "$sandbox/bin/notify-send" <<STUB
#!/bin/bash
printf '%s\n' "\$*" >> "$sandbox/notifylog"
STUB
cat > "$sandbox/bin/aikit-sync" <<STUB
#!/bin/bash
printf '%s\n' "\$*" >> "$sandbox/synclog"
STUB
# tmux bouchonné : les sessions « vivantes » sont les lignes de $sandbox/sessions
cat > "$sandbox/bin/tmux" <<'STUB'
#!/bin/bash
SESS="${SESSIONS:-/dev/null}"
case "$1 $2" in
  "list-sessions -F") grep . "$SESS" 2>/dev/null | cut -d'|' -f1 ;;
  "has-session -t")   grep -q "^$3|" "$SESS" 2>/dev/null ;;
  "new-session -s")   printf 'TMUX-NEW|%s\n' "$3" ;;
  *) exit 0 ;;
esac
STUB
chmod +x "$sandbox/bin/tmux"
: > "$sandbox/sessions"
chmod +x "$sandbox"/bin/*

# --- utilitaires ------------------------------------------------------------
FLOW_DB="$sandbox/data/aikit.db"   # base imposée au lanceur ; vide = son propre défaut
FLOW_ENV=()                        # surcharges d'environnement d'un test (voir « Base »)
flow() { # flow [--args <arg>] <choix...> -> sortie d'aikit (dont la ligne LAUNCH)
  local args=() db=()
  while [[ ${1-} == --args ]]; do args+=("$2"); shift 2; done
  [[ -n $FLOW_DB ]] && db=("AIKIT_DB=$FLOW_DB")
  printf '%s\n' "$@" > "$sandbox/picks"; rm -f "$sandbox/picks.n"
  env -u AIKIT_DB -u XDG_DATA_HOME \
  PATH="$sandbox/bin:$HOME/.local/bin:$PATH" \
  PICKS="$sandbox/picks" TRACE="${VERBOSE:+$sandbox/trace}" SESSIONS="$sandbox/sessions" \
  AIKIT_SHARE="$sandbox/share" AIKIT_CLAUDE_JSON="$sandbox/claude.json" \
  AIKIT_CACHE="$sandbox/cache" AIKIT_ROOTS="$sandbox/repos" AIKIT_LANG=en \
  "${db[@]}" "${FLOW_ENV[@]}" \
    ${AIKIT_XTRACE:+bash -x} "$AIKIT_BIN" "${args[@]}" 2>"$sandbox/err"
  [[ -n ${AIKIT_DEBUG:-} ]] && { echo "--- err ---" >&2; cat "$sandbox/err" >&2; }
}

check() { # check <intitulé> <attendu> <obtenu>
  if [[ $2 == "$3" ]]; then
    ((PASS++)); printf '  \033[32m✓\033[0m %s\n' "$1"
  else
    ((FAIL++)); printf '  \033[31m✗\033[0m %s\n     attendu : %s\n     obtenu  : %s\n' "$1" "$2" "$3"
    [[ -s $sandbox/err ]] && sed 's/^/     err: /' "$sandbox/err"
  fi
}

launched() { sed -n 's/^LAUNCH|.*--exec [^ ]* //p' <<<"$1"; }   # "<dépôt> <prompt>"
session_of() { sed -n 's/^LAUNCH|.*--exec \([^ ]*\) .*/\1/p' <<<"$1"; }

echo "aikit-selftest — bac à sable : $sandbox"
echo

# --- 1. le chemin du dépôt survit aux caractères pénibles -------------------
echo "Dépôts"
out=$(flow "match:beta project" "match:Legacy audit")
check "nom avec espace" "$sandbox/repos/beta project /ai-migration-kit:migrate-assess" "$(launched "$out")"

out=$(flow "match:gamma" "match:Legacy audit")
check "nom contenant le séparateur « · »" "$sandbox/repos/gamma · delta /ai-migration-kit:migrate-assess" "$(launched "$out")"

out=$(flow "match:local-only" "match:Legacy audit")
check "dépôt sans remote GitHub" "$sandbox/repos/local-only /ai-migration-kit:migrate-assess" "$(launched "$out")"

# --- 2. tri ------------------------------------------------------------------
echo "Tri"
out=$(flow "match:Sort:" "match:stars" "index:0" "match:Legacy audit")
check "tri par étoiles : beta (90) en tête" "$sandbox/repos/beta project /ai-migration-kit:migrate-assess" "$(launched "$out")"
check "tri mémorisé" "stars" "$(cat "$sandbox/cache/sort")"

out=$(flow "match:Sort:" "match:open issues" "index:0" "match:Legacy audit")
check "tri par issues : gamma (40) en tête" "$sandbox/repos/gamma · delta /ai-migration-kit:migrate-assess" "$(launched "$out")"
printf 'recent\n' > "$sandbox/cache/sort"

# --- 3. le menu des skills rend bien la skill -------------------------------
echo "Skills"
for pair in "Auto-dev:auto-dev" "Create an issue:create-issue" "Triage:triage-backlog" \
            "Repository profile:profile-repo" "Open follow-ups:review-followups" \
            "Executive audit:migrate-audit" "Full migration:migrate"; do
  label=${pair%%:*} skill=${pair#*:}
  case "$skill" in
    auto-dev)     out=$(flow "match:alpha" "match:$label" "2") ;;
    create-issue) out=$(flow "match:alpha" "match:$label" "une idée" "match:Write it now") ;;
    *)            out=$(flow "match:alpha" "match:$label") ;;
  esac
  check "« $label » lance $skill" "$skill" "$(launched "$out" | sed -n 's#.*/ai-migration-kit:\([a-z-]*\).*#\1#p')"
done

# --- 4. numéros d'issue et de PR --------------------------------------------
echo "Issues et PR"
out=$(flow "match:alpha" "match:Implement an issue" "match:#999 crash")
check "le numéro vient de la clé, pas du titre" "/ai-migration-kit:implement-issue 12" \
      "$(launched "$out" | sed 's#^[^ ]* ##;s#\(implement-issue [0-9]*\).*#\1#;s#^#/ai-migration-kit:#;s#/ai-migration-kit:/ai-migration-kit:#/ai-migration-kit:#')"
out=$(flow "match:alpha" "match:Merge a PR" "match:#111 fix")
check "PR : idem" "/ai-migration-kit:merge-pr 77" \
      "$(launched "$out" | sed 's#^[^ ]* ##')"

# --- 4 a. create-issue v2 : --seed sur une issue sans plan, --grill en option -
echo "Planification"
out=$(flow "match:alpha" "match:Plan an existing issue" "match:unplanned idea" "match:Write it now")
check "issue sans plan → create-issue --seed" "/ai-migration-kit:create-issue --seed #34" \
      "$(launched "$out" | sed 's#^[^ ]* ##')"
out=$(flow "match:alpha" "match:Plan an existing issue" "match:#999 crash" "match:Write it now")
check "une issue déjà planifiée n'est pas proposée" "" "$(launched "$out")"
out=$(flow "match:alpha" "match:Plan an existing issue" "match:unplanned idea" "match:Interview me first")
check "--grill se compose avec --seed" "/ai-migration-kit:create-issue --seed #34 --grill" \
      "$(launched "$out" | sed 's#^[^ ]* ##')"
out=$(flow "match:alpha" "match:Create an issue" "une idée" "match:Interview me first")
check "--grill sur une idée neuve" "/ai-migration-kit:create-issue --grill une idée" \
      "$(launched "$out" | sed 's#^[^ ]* ##')"
out=$(flow "match:alpha" "match:Create an issue" "une idée" "match:Write it now")
check "sans grill : prompt inchangé" "/ai-migration-kit:create-issue une idée" \
      "$(launched "$out" | sed 's#^[^ ]* ##')"
out=$(flow "match:alpha" "match:Create an issue" "une idée" "cancel" "match:Legacy audit")
check "Échap au choix grill → retour au menu des skills" \
      "$sandbox/repos/alpha /ai-migration-kit:migrate-assess" "$(launched "$out")"
rm -f "$sandbox/trace"; VERBOSE=1 flow "match:alpha" "cancel" >/dev/null
check "sous-titre : nombre d'issues sans plan" "1" \
      "$(grep -c 'Plan an existing issue.*1 issues without a plan' "$sandbox/trace")"

# --- 4 quinquies. session Claude libre : pas de prompt, un worktree neuf ----
# La ligne LAUNCH porte "--exec <session> <dépôt> <prompt> [flags]" ; un prompt
# vide laisse un champ vide entre le dépôt et les flags.
echo "Session Claude"
# alpha est déjà « trusted » par Claude Code, local-only ne l'est pas encore
printf '{"projects":{"%s":{"hasTrustDialogAccepted":true}}}\n' "$sandbox/repos/alpha" > "$sandbox/claude.json"
out=$(flow "match:	alpha	" "match:Open Claude")
check "« Open Claude » : dépôt, prompt vide, --worktree" \
      "$sandbox/repos/alpha  --worktree" "$(launched "$out")"
out=$(flow --args claude "match:	alpha	")
check "aikit claude : dépôt demandé, pas de menu des skills" \
      "$sandbox/repos/alpha  --worktree" "$(launched "$out")"
out=$(flow "match:local-only" "match:Open Claude" "match:Open Claude in the checkout")
check "pas encore trusted → question, puis session dans le checkout, sans worktree" \
      "$sandbox/repos/local-only " "$(launched "$out")"
check "la confiance reste à Claude : rien n'est écrit" "false" \
      "$(jq -r --arg d "$sandbox/repos/local-only" '.projects[$d] != null' "$sandbox/claude.json")"
out=$(flow "match:local-only" "match:Open Claude" "match:Back" "match:Legacy audit")
check "refus → retour au menu des skills" \
      "$sandbox/repos/local-only /ai-migration-kit:migrate-assess" "$(launched "$out")"
rm -f "$sandbox/claude.json"
out=$(flow --args claude "match:	alpha	" "cancel")
check "sans ~/.claude.json : personne n'est trusted, Échap sort" "" "$(launched "$out")"
# --run : le prompt vide ne doit pas devenir un argument "" pour claude
cat > "$sandbox/bin/claude" <<'STUB'
#!/bin/bash
printf 'CLAUDE|%d|%s\n' "$#" "$*"
STUB
chmod +x "$sandbox/bin/claude"
out=$(PATH="$sandbox/bin:$PATH" AIKIT_CACHE="$sandbox/cache" AIKIT_SHARE="$sandbox/share" AIKIT_LANG=en \
      "$AIKIT_BIN" --run "$sandbox/repos/alpha" "" "" --worktree </dev/null 2>/dev/null | grep '^CLAUDE|')
check "--run sans prompt : claude reçoit les flags seuls" \
      "CLAUDE|2|--dangerously-skip-permissions --worktree" "$out"
out=$(PATH="$sandbox/bin:$PATH" AIKIT_CACHE="$sandbox/cache" AIKIT_SHARE="$sandbox/share" AIKIT_LANG=en \
      "$AIKIT_BIN" --run "$sandbox/repos/alpha" "/x y" "" </dev/null 2>/dev/null | grep '^CLAUDE|')
check "--run avec prompt : flags puis prompt" \
      "CLAUDE|2|--dangerously-skip-permissions /x y" "$out"
printf '#!/bin/bash\necho "--dangerously-skip-permissions --worktree"\n' > "$sandbox/bin/claude"

# --- 4 bis. file de travail transversale ------------------------------------
echo "File de travail"
out=$(flow --args work "match:#77 #111 fix")
check "PR en CI rouge → merge-pr dans le bon clone" \
      "$sandbox/repos/alpha /ai-migration-kit:merge-pr 77" "$(launched "$out")"

out=$(flow --args work "match:do the needful")
check "issue assignée → implement-issue, autre dépôt, sans redemander le dépôt" \
      "$sandbox/repos/beta project /ai-migration-kit:implement-issue 5" "$(launched "$out")"

out=$(flow --args work "match:no clone here")
check "sans clone local → ouverture sur GitHub" \
      "WEBAPP|GitHub https://github.com/acme/remote-only/pull/9" "$(grep '^WEBAPP|' <<<"$out")"

# --- 4 ter. sessions tmux : un dépôt, une session ---------------------------
echo "Sessions"
out=$(flow "match:	alpha	" "match:Legacy audit")
check "session nommée d'après le dépôt distant" "aikit-acme-alpha" "$(session_of "$out")"

out=$(flow "match:	alpha	other" "match:Legacy audit")
check "même nom de dossier, autre propriétaire → autre session" "aikit-other-alpha" "$(session_of "$out")"

printf 'aikit-acme-alpha|1\n' > "$sandbox/sessions"
out=$(flow "match:	alpha	" "match:Legacy audit")
check "session déjà prise → nouvelle session, pas un rattachement muet" "aikit-acme-alpha-2" "$(session_of "$out")"

out=$(flow "match:	alpha	" "match:Resume")
check "« reprendre » vise la session existante, sans en créer" \
      "ATTACH|--app-id=org.omarchy.aikit tmux attach -t aikit-acme-alpha" "$(grep '^ATTACH|' <<<"$out")"
: > "$sandbox/sessions"

out=$(flow "match:local-only" "match:Legacy audit")
check "dépôt sans remote → session dérivée du chemin" "1" \
      "$(grep -cE '^aikit-local-only-[0-9]+$' <<<"$(session_of "$out")")"

# une session finie (claude rendu, pane encore ouvert) ne doit plus compter
printf 'aikit-acme-alpha|1\n' > "$sandbox/sessions"
mkdir -p "$sandbox/cache/done"; echo 0 > "$sandbox/cache/done/aikit-acme-alpha"
out=$(flow "match:	alpha	" "match:Legacy audit")
check "session terminée → pas de ligne « reprendre »" "" \
      "$(grep -o 'Resume the running session' <<<"$out")"
check "session terminée → la nouvelle session prend un nom libre" "aikit-acme-alpha-2" "$(session_of "$out")"
rm -rf "$sandbox/cache/done"; : > "$sandbox/sessions"

# --- 4 quater. navigation en arrière ----------------------------------------
echo "Navigation"
out=$(flow "match:	alpha	" "cancel" "match:	beta project	" "match:Legacy audit")
check "Échap au menu des skills → retour au choix du dépôt" \
      "$sandbox/repos/beta project /ai-migration-kit:migrate-assess" "$(launched "$out")"

out=$(flow "match:	alpha	" "match:Back" "match:	beta project	" "match:Legacy audit")
check "ligne « Back » → retour au choix du dépôt" \
      "$sandbox/repos/beta project /ai-migration-kit:migrate-assess" "$(launched "$out")"

out=$(flow "match:	alpha	" "match:Implement an issue" "cancel" "match:Legacy audit")
check "Échap au choix de l'issue → retour au menu des skills" \
      "$sandbox/repos/alpha /ai-migration-kit:migrate-assess" "$(launched "$out")"

out=$(flow "match:	alpha	" "match:Implement an issue" "match:Back" "match:Legacy audit")
check "ligne « Back » dans la liste des issues → menu des skills" \
      "$sandbox/repos/alpha /ai-migration-kit:migrate-assess" "$(launched "$out")"

out=$(flow "cancel")
check "Échap au choix du dépôt → on sort" "" "$(launched "$out")"

# --- 5. la base : où on la cherche, et quand on l'amorce -------------------
# Régression : AIKIT_DB était déduit du dossier des ressources. Dès que celui-ci
# n'était pas ~/.local/share/aikit (paquet en /usr/share, copie de travail), la
# base paraissait absente et chaque lancement la réamorçait — un « premier
# lancement » à chaque clic dans la barre.
echo "Base"
mkdir -p "$sandbox/xdg/aikit"
cp "$sandbox/data/aikit.db" "$sandbox/xdg/aikit/aikit.db"
: > "$sandbox/synclog"
FLOW_DB="" FLOW_ENV=("XDG_DATA_HOME=$sandbox/xdg")
out=$(flow "match:	alpha	" "match:Legacy audit")
FLOW_DB="$sandbox/data/aikit.db" FLOW_ENV=()
check "sans AIKIT_DB : base lue dans le dossier de données" \
      "$sandbox/repos/alpha /ai-migration-kit:migrate-assess" "$(launched "$out")"
check "base peuplée : aucun réamorçage" "0" "$(grep -c -- "--repos --force" "$sandbox/synclog")"

# Anti-rebond : un amorçage qui échoue (gh non authentifié, réseau coupé) laisse
# la base vide. Sans horodatage, le clic suivant repartait pour une
# synchronisation bloquante et une notification de plus — à chaque clic.
echo "Amorçage"
mkdir -p "$sandbox/vide"
FLOW_DB="$sandbox/vide/aikit.db"          # base absente : le garde-fou se déclenche
rm -f "$sandbox/cache/seeded"
: > "$sandbox/synclog"; : > "$sandbox/notifylog"
flow "cancel" >/dev/null
check "base absente : un amorçage" "1" "$(grep -c -- "--repos --force" "$sandbox/synclog")"
check "échec dit une fois" "1" "$(grep -c "Could not fill" "$sandbox/notifylog")"
flow "cancel" >/dev/null
check "clic suivant : pas de second amorçage" "1" "$(grep -c -- "--repos --force" "$sandbox/synclog")"
check "clic suivant : pas de seconde notification" "1" "$(grep -c "Could not fill" "$sandbox/notifylog")"
FLOW_ENV=("AIKIT_SEED_RETRY_SECS=0")
flow "cancel" >/dev/null
FLOW_ENV=()
check "fenêtre écoulée : on retente" "2" "$(grep -c -- "--repos --force" "$sandbox/synclog")"
FLOW_DB="$sandbox/data/aikit.db"

# --- 5 bis. doctor : le kit doit être en v2 (les noms de skills n'ont pas d'alias)
echo "Doctor"
kit_at() { # kit_at <version...> -> un $HOME factice avec ces versions du kit en cache
  rm -rf "$sandbox/home"
  for v in "$@"; do mkdir -p "$sandbox/home/.claude/plugins/cache/m/ai-migration-kit/$v"; done
}
kit_line() { FLOW_ENV=("HOME=$sandbox/home"); flow --args doctor | grep 'ai-migration-kit'; FLOW_ENV=(); }
kit_at 1.15.0
check "kit 1.15.0 → manquant, avec le conseil de mise à jour" "1" \
      "$(kit_line | grep -c '✗.*2.0.0.*update')"
kit_at 2.0.0
check "kit 2.0.0 → ok" "1" "$(kit_line | grep -c '✓')"
kit_at 1.15.0 2.1.0
check "plusieurs versions en cache → la plus haute compte" "1" "$(kit_line | grep -c '✓')"
kit_at
check "kit absent → manquant" "1" "$(kit_line | grep -c '✗')"

# --- 6. compteurs -----------------------------------------------------------
echo "Compteurs"
eval "$(python3 "$sandbox/share/rows.py" counts "$sandbox/data/aikit.db" acme/alpha)"
check "dépôt suivi : 2 issues, 1 planifiée, 1 éligible" "2 1 1" "$ISSUES $PLANNED $ELIGIBLE"
eval "$(python3 "$sandbox/share/rows.py" counts "$sandbox/data/aikit.db" acme/beta)"
check "dépôt non détaillé : totaux étage 1, détail inconnu" "7 -1 -1" "$ISSUES $PLANNED $ELIGIBLE"

# --- 7. le catalogue couvre toutes les clés utilisées -----------------------
echo "Chaînes"
used=$( {
    # les clés littérales : toutes passent par $(t clé) ou T("clé")
    grep -ohE '\$\(t [a-z][a-z0-9_]*' "$AIKIT_BIN" \
         "$SELF_DIR/aikit-status" | sed 's/.*(t //'
    grep -ohE 'T\("[a-z][a-z0-9_]*"' "$SHARE/rows.py" | sed 's/T("//;s/"//' | grep -v '_$'
    # les clés construites à l'exécution
    printf 'ci_ok\nci_fail\nci_pending\nci_none\n'
    printf 'sort_recent\nsort_pushed\nsort_name\nsort_stars\nsort_issues\nsort_prs\n'
    printf 'no_repo\nno_repo_gh\n'
    printf 'kind_failing\nkind_review\nkind_mine\nkind_assigned\nkind_planned\n'
    printf 'back_row\nback_hint\nsession_finished\nbar_finished\n'
  } | sort -u )

for lang in en fr; do
  missing=$(python3 - "$SHARE/strings.json" "$lang" <<PY
import json, sys
cat = json.load(open(sys.argv[1]))[sys.argv[2]]
print(" ".join(k for k in """$used""".split() if k not in cat))
PY
)
  check "aucune clé manquante en $lang" "" "$missing"
done

# --- verdict ----------------------------------------------------------------
echo
if ((FAIL)); then
  printf '\033[31m%d échec(s)\033[0m sur %d vérifications\n' "$FAIL" "$((PASS + FAIL))"
  exit 1
fi
printf '\033[32m%d vérifications passées\033[0m\n' "$PASS"
