#!/bin/bash
# ---------------------------------------------------------------------------
# aikit — lance une skill de l'AI Migration Kit sur un dépôt, depuis le GUI.
#
#   aikit                    dépôt → skill → paramètres (parcours principal)
#   aikit work               ce qui m'attend, tous dépôts confondus
#   aikit <skill>            raccourci : skill imposée, dépôt demandé
#   aikit attach             réattache une session aikit en cours
#   aikit sync               force une synchronisation de la base
#   aikit --exec <s> <d> <p> interne : ouvre la session tmux
#   aikit --run <d> <p> <s>  interne : lance claude et notifie à la fin
#
# Les menus ne touchent jamais le réseau : tout vient de la base locale
# (~/.local/share/aikit/aikit.db) tenue à jour par aikit-sync.timer.
#
# Contrat des menus : chaque ligne est "<clé>\t<glyphe>\t<libellé>\t<sous-titre>".
# menu_pick n'envoie que l'affichage au menu et rend la clé — rien n'est jamais
# reconstitué en redécoupant le texte montré à l'utilisateur.
#
# Réglages : AIKIT_ROOTS        racines de recherche des dépôts
#            AIKIT_CLAUDE_FLAGS défaut : --permission-mode auto
#            AIKIT_LANG         en / fr (défaut : la locale du système)
# ---------------------------------------------------------------------------
set -euo pipefail

AIKIT_VERSION="0.1.0"

# Où suis-je ? Le chemin sert à se relancer dans tmux : il doit rester valable
# aussi bien depuis ~/.local/bin que depuis /usr/bin ou une copie de travail.
SELF=$0
[[ $SELF == */* ]] || SELF=$(command -v -- "$SELF")
SELF=$(cd -- "$(dirname -- "$SELF")" && pwd)/$(basename -- "$SELF")
SELF_DIR=$(dirname -- "$(readlink -f -- "$SELF")")

# ~/.local/bin doit être joignable depuis la session tmux, mais sans passer
# devant un PATH déjà préparé (bac à sable des tests, wrappers).
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Ressources (rows.py, i18n.sh, strings.json) : à côté du script pour une copie
# de travail, sinon ../share/aikit pour une installation en préfixe, sinon ~/.
find_share() {
  local d
  for d in "${AIKIT_SHARE-}" "$SELF_DIR/../share" "$SELF_DIR/../share/aikit" \
           "$HOME/.local/share/aikit" /usr/share/aikit /usr/local/share/aikit; do
    [[ -n $d && -f $d/rows.py && -f $d/i18n.sh && -f $d/strings.json ]] && {
      (cd -- "$d" && pwd); return 0; }
  done
  return 1
}
AIKIT_SHARE=$(find_share) || {
  echo "aikit: resources not found (rows.py, i18n.sh, strings.json)" >&2
  echo "       try AIKIT_SHARE=<dir>, or re-run install.sh" >&2
  exit 1
}
source "$AIKIT_SHARE/i18n.sh"

# Réglages persistants, éventuellement écrits par « aikit doctor »
AIKIT_CONFIG=${AIKIT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/aikit/config}
[[ -f $AIKIT_CONFIG ]] && source "$AIKIT_CONFIG"

# Racines par défaut : les emplacements de clones les plus courants, filtrés
# sur ce qui existe réellement chez l'utilisateur.
default_roots() {
  local d found=()
  for d in "$HOME/src" "$HOME/code" "$HOME/dev" "$HOME/git" "$HOME/repos" \
           "$HOME/Projects" "$HOME/Work" "$HOME/Development" "$HOME/Data/Repositories"; do
    [[ -d $d ]] && found+=("$d")
  done
  ((${#found[@]})) || found=("$HOME")
  printf '%s\n' "${found[*]}"
}
AIKIT_ROOTS=${AIKIT_ROOTS:-$(default_roots)}
AIKIT_CLAUDE_FLAGS=${AIKIT_CLAUDE_FLAGS:---permission-mode auto}
AIKIT_CACHE=${AIKIT_CACHE:-$HOME/.cache/aikit}
AIKIT_STATE_DIR="$AIKIT_CACHE/state"
AIKIT_SORT_FILE="$AIKIT_CACHE/sort"
AIKIT_SEED_STAMP="$AIKIT_CACHE/seeded"   # dernière tentative d'amorçage
# La base est une donnée, pas une ressource : elle vit dans le dossier de
# données, comme chez aikit-sync et aikit-status. La chercher à côté de rows.py
# la rendait « absente » à chaque lancement dès que les ressources venaient
# d'ailleurs (/usr/share en lecture seule, ou une copie de travail du dépôt) :
# le lanceur réamorçait alors la base à chaque clic dans la barre.
AIKIT_DATA=${AIKIT_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/aikit}
AIKIT_DB=${AIKIT_DB:-$AIKIT_DATA/aikit.db}
ROWS="$AIKIT_SHARE/rows.py"

# Glyphes en points de code : un glyphe collé ne survit pas toujours au trajet
# jusqu'au fichier. Tous vérifiés présents dans JetBrainsMono Nerd Font.
G_RESUME=$''        # ▶  reprendre
G_AUTODEV=$'\U000F14DE'   # 🚀 fusée
G_IMPLEMENT=$''     # </> code
G_MERGE=$''         # ᛦ  git-merge
G_CREATE=$''        # ✎  éditer
G_TRIAGE=$'\U000F0232'    # ⏳ entonnoir
G_SETUP=$''         # ⚙  engrenage
G_PROFILE=$''       # 🔧 clé
G_FOLLOWUPS=$''     # ☑  case cochée
G_ASSESS=$''        # 🔍 loupe
G_MIGRATE=$'\U000F0450'   # ↻  cycle
G_SORT=$''          # ⇅  tri
G_WORK=$'\uF03A'       # ☰  file de travail
G_DONE=$'\uF00C'       # ✓  session terminée
G_BACK=$'\uF053'       # ‹  retour

notify() { command -v notify-send >/dev/null && notify-send -a "AI Kit" "$@" || true; }
die() { notify "$1" "${2-}"; echo "aikit: $1 ${2-}" >&2; exit 1; }
slugify() { tr '[:upper:]' '[:lower:]' <<<"$1" | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//'; }

# Nom de session : deux dépôts peuvent porter le même nom de dossier chez des
# propriétaires différents (phmatray/.github et Atypical-Consulting/.github).
# Le nom de session doit donc venir du dépôt distant, ou à défaut du chemin.
session_base() { # session_base <chemin> <nwo>
  if [[ -n ${2-} ]]; then
    printf 'aikit-%s\n' "$(slugify "$2")"
  else
    printf 'aikit-%s-%s\n' "$(slugify "$(basename "$1")")" \
      "$(cksum <<<"$1" | cut -d' ' -f1)"
  fi
}

# Une session par lancement : `new-session -A` rattacherait la précédente en
# ignorant silencieusement la skill demandée.
free_session() { local base="$1" name="$1" n=2
  while tmux has-session -t "$name" 2>/dev/null; do name="$base-$((n++))"; done
  printf '%s\n' "$name"
}

sessions_of() { # sessions_of <base> [--include-done] -> sessions de ce dépôt
  local base="$1" all="${2-}" s
  tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -E "^$base(-[0-9]+)?$" |
    while read -r s; do
      [[ -n $all || ! -f "$AIKIT_CACHE/done/$s" ]] && printf '%s\n' "$s"
    done
}

session_done() { [[ -f "$AIKIT_CACHE/done/$1" ]]; }
nwo_of() { # "" si le dépôt n'a pas de remote GitHub, ou si git refuse de le lire
  local url
  url=$(git -C "$1" config --get remote.origin.url 2>/dev/null) || return 0
  sed -nE 's#.*github\.com[:/]([^/]+)/(.+)$#\1/\2#p' <<<"$url" | sed 's/\.git$//'   # ERE n'a pas de quantificateur paresseux
}

usage() {
  cat <<USAGE
aikit $AIKIT_VERSION — run AI Migration Kit skills from the desktop.

  aikit                 pick a repository, then a skill
  aikit work            what is waiting for you, across every repository
  aikit <skill> [args]  force the skill (auto-dev, implement-issue, merge-pr…)
  aikit attach          re-attach a running session
  aikit sync            force a database sync
  aikit setup           install the Omarchy entries (menu, bar widget)
  aikit doctor          check the prerequisites
  aikit --help | --version

Settings (environment variables, or $AIKIT_CONFIG):
  AIKIT_ROOTS          where to look for clones
                       (currently: $AIKIT_ROOTS)
  AIKIT_CLAUDE_FLAGS   flags passed to claude ($AIKIT_CLAUDE_FLAGS)
  AIKIT_LANG           en | fr (currently: $AIKIT_L)
  AIKIT_STALL_SECS     silence after which an agent is deemed stuck
USAGE
}

doctor() {
  local ok=0 miss=0
  line() { # line <intitulé> <état> [conseil]
    if [[ $2 == ok ]]; then
      printf '  \033[32m✓\033[0m %-28s %s\n' "$1" "$(t doctor_ok)"; ok=$((ok + 1))
    else
      printf '  \033[31m✗\033[0m %-28s %s%s\n' "$1" "$(t doctor_missing)" "${3:+ — $3}"; miss=$((miss + 1))
    fi
  }
  echo "aikit $AIKIT_VERSION"
  echo
  for c in tmux jq python3 sqlite3 git; do
    line "$c" "$(command -v "$c" >/dev/null && echo ok || echo no)"
  done
  line claude "$(command -v claude >/dev/null && echo ok || echo no)" \
       "https://claude.com/claude-code"
  # Le mode auto est récent : sans lui, chaque session s'ouvrirait sur une
  # erreur de commande. On lit les choix annoncés par claude lui-même.
  command -v claude >/dev/null &&
    line "claude auto mode" \
         "$(claude --help 2>/dev/null | grep -q '"auto"' && echo ok || echo no)" \
         "$(t doctor_hint_auto)"
  line gh "$(command -v gh >/dev/null && echo ok || echo no)" "$(t doctor_hint_gh)"
  command -v gh >/dev/null &&
    line "gh auth" "$(gh auth status >/dev/null 2>&1 && echo ok || echo no)" "gh auth login"
  line "ai-migration-kit" \
       "$(ls -d "$HOME"/.claude/plugins/cache/*/ai-migration-kit/* >/dev/null 2>&1 && echo ok || echo no)" \
       "$(t doctor_hint_kit)"
  line "omarchy-menu-select" "$(command -v omarchy-menu-select >/dev/null && echo ok || echo no)" \
       "https://omarchy.org"
  local n; n=$(list_repos | wc -l)
  line "$(t doctor_roots) ($n)" "$( ((n)) && echo ok || echo no)" "$(t doctor_none): $AIKIT_ROOTS"
  line "aikit-sync.timer" \
       "$(systemctl --user is-active aikit-sync.timer >/dev/null 2>&1 && echo ok || echo no)" \
       "systemctl --user enable --now aikit-sync.timer"
  echo
  command -v aikit-sync >/dev/null && aikit-sync --status
  ((miss == 0))
}

case "${1-}" in
  -h|--help|help) usage; exit 0 ;;
  -V|--version)   echo "aikit $AIKIT_VERSION"; exit 0 ;;
esac

# --- modes internes ---------------------------------------------------------
if [[ ${1-} == --exec ]]; then
  exec tmux new-session -s "$2" -c "$3" "$SELF" --run "$3" "$4" "$2"
fi

if [[ ${1-} == --run ]]; then
  dir="$2" prompt="$3" session="${4-}" rc=0
  repo=$(basename "$dir")
  claude $AIKIT_CLAUDE_FLAGS "$prompt" || rc=$?
  [[ -n $session ]] && rm -f "$AIKIT_CACHE/notified/$session"
  if ((rc == 0)); then
    notify "$(t done_ok_title "$repo")" "$(t done_ok_body)"
  else
    notify -u critical "$(t done_err_title "$repo")" "$(t done_err_body "$rc")"
  fi
  # claude a rendu la main mais le pane reste ouvert pour que la sortie soit
  # lisible : la session tmux existe encore. On la marque terminée, sinon elle
  # continue de compter comme active dans la barre et dans les listes.
  if [[ -n $session ]]; then
    mkdir -p "$AIKIT_CACHE/done"
    printf '%s\n' "$rc" > "$AIKIT_CACHE/done/$session"
    trap 'rm -f "$AIKIT_CACHE/done/$session"' EXIT
  fi
  printf '\n\033[2m%s\033[0m\n' "$(t press_enter "$rc")"
  read -r _ || true
  exit "$rc"
fi

if [[ ${1-} == sync ]]; then
  rm -f "$AIKIT_SEED_STAMP"        # geste explicite : on repart d'une ardoise nette
  exec omarchy-launch-tui --app-id=org.omarchy.aikit \
    bash -c "aikit-sync --force; aikit-sync --status; read -n1 -r"
fi

# --- menus ------------------------------------------------------------------
declare -A MENU_KEY
MENU_ARGS=(--width 760 --height 520)

menu_pick() { # menu_pick <invite> <ligne...> -> clé de la ligne choisie
  local prompt="$1"; shift
  local display=() row rest sel
  MENU_KEY=()
  for row in "$@"; do
    rest=${row#*$'\t'}                       # "<glyphe>\t<libellé>\t<sous-titre>"
    display+=("$rest")
    MENU_KEY["${rest#*$'\t'}"]=${row%%$'\t'*} # le menu rend "<libellé>\t<sous-titre>"
  done
  ((${#display[@]})) || return 1
  sel=$(omarchy-menu-select "$prompt" "${display[@]}" -- "${MENU_ARGS[@]}") || return 1
  printf '%s\n' "${MENU_KEY[$sel]-}"
}

ask() { omarchy-menu-input "$1" --width 520; }
row() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"; }   # clé glyphe libellé sous-titre

# --- dépôts -----------------------------------------------------------------
list_repos() { # émet "<date de modif>\t<chemin>" ; rows.py se charge du tri
  local only_gh=${1-} mtime path
  find $AIKIT_ROOTS -maxdepth 4 -type d -name .git -printf '%T@\t%h\n' 2>/dev/null |
    while IFS=$'\t' read -r mtime path; do
      [[ -z $only_gh ]] || grep -qs 'github\.com' "$path/.git/config" || continue
      printf '%s\t%s\n' "$mtime" "$path"
    done
}

sort_mode() { cat "$AIKIT_SORT_FILE" 2>/dev/null || echo recent; }

choose_sort() { # mémorise le tri choisi ; l'annulation garde le tri courant
  local rows=() key m
  for m in recent pushed name stars issues prs; do
    rows+=("$(row "$m" "$G_SORT" "$(t "sort_$m")" " ")")
  done
  MENU_ARGS=(--width 520)
  key=$(menu_pick "$(t sort_prompt)" "${rows[@]}") || return 0
  [[ -n $key ]] || return 0
  mkdir -p "$AIKIT_CACHE"
  printf '%s\n' "$key" > "$AIKIT_SORT_FILE"
}

pick_repo() { # -> chemin du dépôt choisi
  local rows=() key mode
  while :; do
    mode=$(sort_mode)
    mapfile -t rows < <(
      row "__sort__" "$G_SORT" "$(t sort_row "$(t "sort_$mode")")" "$(t sort_hint)"
      AIKIT_SESSIONS="$(tmux list-sessions -F '#{session_name}' 2>/dev/null |
                        sed -n 's/^aikit-//p' | tr '\n' ' ')" \
      list_repos "${1-}" | python3 "$ROWS" repos "$AIKIT_DB" "$mode")
    ((${#rows[@]} > 1)) || die "$(t "${1:+no_repo_gh}${1:-no_repo}" "$AIKIT_ROOTS")"
    MENU_ARGS=(--width 760 --height 520)
    key=$(menu_pick "$(t repo_prompt)" "${rows[@]}") || return 1
    case "$key" in
      "")        return 1 ;;
      __sort__)  choose_sort ;;
      *)         printf '%s\n' "$key"; return 0 ;;
    esac
  done
}

# --- base locale ------------------------------------------------------------
counts_of() { # remplit ISSUES/PLANNED/ELIGIBLE/PRS/PRS_RED/AGE
  ISSUES=0 PLANNED=0 ELIGIBLE=0 PRS=0 PRS_RED=0 AGE=-1
  [[ -n ${1-} ]] || return 0
  eval "$(python3 "$ROWS" counts "$AIKIT_DB" "$1" 2>/dev/null)"
}

freshen() { # <nwo> <chemin> — suit le dépôt, puis rafraîchit en arrière-plan
  [[ -n $1 ]] || return 0
  aikit-sync --track "$1" --path "$2" 2>/dev/null || true
  ( aikit-sync --repo "$1" >/dev/null 2>&1 & ) || true
}

pick_number() { # <dépôt> <nwo> <issues|prs> <invite> -> numéro choisi
  local repo="$1" nwo="$2" kind="$3" prompt="$4" rows=() key age=""
  [[ -n $nwo ]] || { ask "$(t ask_number "$prompt")"; return; }
  if ((AGE < 0)); then                       # jamais synchronisé en détail
    notify "$(t reading_github)" "$nwo"
    aikit-sync --repo "$nwo" >/dev/null 2>&1 || true
    counts_of "$nwo"
  fi
  mapfile -t rows < <(python3 "$ROWS" "$kind" "$AIKIT_DB" "$nwo")
  ((${#rows[@]})) || die "$(t nothing_open)" "$(basename "$repo")"
  rows+=("$(row "__back" "$G_BACK" "$(t back_row)" "$(t back_hint)")")
  ((AGE >= 0)) && age=" · $(t stale "$AGE min")"
  MENU_ARGS=(--width 880 --height 560)
  key=$(menu_pick "$prompt$age" "${rows[@]}") || return 1
  printf '%s\n' "$key"
}

# --- choix de la skill ------------------------------------------------------
q() { (($1 < 0)) && echo "?" || echo "$1"; }   # compteur pas encore connu

pick_skill() { # <dépôt> <nwo> -> identifiant de skill
  local repo="$1" nwo="$2" rows=() session

  session=$(sessions_of "$(session_base "$repo" "$nwo")" | head -1)
  [[ -n $session ]] &&
    rows+=("$(row "__attach|$session" "$G_RESUME" "$(t skill_resume)" "$(t skill_resume_d "$session")")")

  if [[ -n $nwo ]]; then
    rows+=("$(row "auto-dev"         "$G_AUTODEV"   "$(t skill_autodev)"   "$(t skill_autodev_d "$(q "$ELIGIBLE")")")")
    rows+=("$(row "implement-issue"  "$G_IMPLEMENT" "$(t skill_implement)" "$(t skill_implement_d "$(q "$PLANNED")")")")
    rows+=("$(row "merge-pr"         "$G_MERGE"     "$(t skill_merge)"     "$(t skill_merge_d "$(q "$PRS")" "$(q "$PRS_RED")")")")
    rows+=("$(row "create-issue"     "$G_CREATE"    "$(t skill_create)"    "$(t skill_create_d)")")
    rows+=("$(row "triage-backlog"   "$G_TRIAGE"    "$(t skill_triage)"    "$(t skill_triage_d "$(q "$ISSUES")")")")
    rows+=("$(row "setup-repo"       "$G_SETUP"     "$(t skill_setup)"     "$(t skill_setup_d)")")
    rows+=("$(row "get-repo-profile" "$G_PROFILE"   "$(t skill_profile)"   "$(t skill_profile_d)")")
  fi
  rows+=("$(row "followups"      "$G_FOLLOWUPS" "$(t skill_followups)" "$(t skill_followups_d)")")
  rows+=("$(row "migrate-assess" "$G_ASSESS"    "$(t skill_assess)"    "$(t skill_assess_d)")")
  rows+=("$(row "migrate"        "$G_MIGRATE"   "$(t skill_migrate)"   "$(t skill_migrate_d)")")

  rows+=("$(row "__back" "$G_BACK" "$(t back_row)" "$(t back_hint)")")
  MENU_ARGS=(--width 880 --height 560)
  menu_pick "$(basename "$repo")" "${rows[@]}"
}

# --- réattachement ----------------------------------------------------------
attach_session() {
  local sel="${1-}" rows=() s sessions=()
  if [[ -z $sel ]]; then
    mapfile -t sessions < <(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^aikit-' || true)
    ((${#sessions[@]})) || die "$(t no_session)"
    if ((${#sessions[@]} == 1)); then
      sel="${sessions[0]}"
    else
      for s in "${sessions[@]}"; do
        if session_done "$s"; then
          rows+=("$(row "$s" "$G_DONE" "${s#aikit-}" "$(t session_finished "$(cat "$AIKIT_CACHE/done/$s")")")")
        else
          rows+=("$(row "$s" "$G_RESUME" "${s#aikit-}" "tmux $s")")
        fi
      done
      MENU_ARGS=(--width 520)
      sel=$(menu_pick "$(t session_prompt)" "${rows[@]}") || exit 0
      [[ -n $sel ]] || exit 0
    fi
  fi
  rm -f "$AIKIT_CACHE/notified/$sel"
  exec omarchy-launch-or-focus-tui --app-id=org.omarchy.aikit "tmux attach -t $sel"
}

launch() { # <titre> <dépôt> <prompt> — une session neuve, jamais un rattachement
  local title="$1" repo="$2" prompt="$3" session
  session=$(free_session "$(session_base "$repo" "$(nwo_of "$repo")")")
  mkdir -p "$AIKIT_CACHE/notified" "$AIKIT_CACHE/done"
  rm -f "$AIKIT_CACHE/notified/$session" "$AIKIT_CACHE/done/$session"
  notify "$title" "$(basename "$repo")  ·  tmux: $session"
  exec omarchy-launch-tui --app-id=org.omarchy.aikit \
    "$SELF" --exec "$session" "$repo" "$prompt"
}

# --- boîte de travail transversale ------------------------------------------
# La clé d'une ligne porte tout ce qu'il faut pour agir : genre, dépôt distant,
# numéro et clone local. Plus besoin de repasser par le choix du dépôt.
work_queue() {
  local rows=() key kind nwo number path skill prompt
  mapfile -t rows < <(python3 "$ROWS" inbox "$AIKIT_DB")
  ((${#rows[@]})) || die "$(t inbox_empty)"
  MENU_ARGS=(--width 980 --height 600)
  key=$(menu_pick "$(t inbox_prompt)" "${rows[@]}") || exit 0
  [[ -n $key ]] || exit 0
  IFS='|' read -r kind nwo number path <<<"$key"

  if [[ -z $path || ! -d $path ]]; then      # pas de clone : on ouvre sur GitHub
    local url="https://github.com/$nwo/issues/$number"
    [[ $kind == assigned || $kind == planned ]] || url="https://github.com/$nwo/pull/$number"
    notify "$(t inbox_nolocal)" "$nwo#$number"
    exec omarchy-launch-or-focus-webapp "GitHub" "$url"
  fi

  case "$kind" in
    failing|mine) skill="merge-pr"        prompt="/ai-migration-kit:merge-pr $number" ;;
    review)       skill="code-review"     prompt="/code-review $number" ;;
    *)            skill="implement-issue" prompt="/ai-migration-kit:implement-issue $number" ;;
  esac
  aikit-sync --track "$nwo" --path "$path" 2>/dev/null || true
  launch "$skill #$number" "$path" "$prompt"
}

[[ ${1-} == doctor ]] && { doctor; exit $?; }
if [[ ${1-} == setup ]]; then
  merge="$AIKIT_SHARE/omarchy/merge-config.py"
  [[ -f $merge ]] || merge="$SELF_DIR/../omarchy/merge-config.py"
  [[ -f $merge ]] || die "aikit: merge-config.py not found"
  exec python3 "$merge" "${@:2}"
fi
[[ ${1-} == attach ]] && attach_session
[[ ${1-} == work ]] && work_queue

# Base absente ou vide : on l'amorce plutôt que d'afficher « ? » partout.
# Anti-rebond : quand l'amorçage échoue (gh non authentifié, réseau coupé), la
# base reste vide — sans horodatage, chaque clic dans la barre repartirait pour
# une synchronisation bloquante et une notification de plus. On ne retente donc
# qu'après AIKIT_SEED_RETRY_SECS, et l'échec se dit une fois par fenêtre.
db_empty() { [[ ! -f $AIKIT_DB ]] || [[ -z $(sqlite3 "$AIKIT_DB" "SELECT 1 FROM repos LIMIT 1" 2>/dev/null) ]]; }

if db_empty; then
  seed_last=0
  [[ -f $AIKIT_SEED_STAMP ]] && seed_last=$(<"$AIKIT_SEED_STAMP")
  [[ $seed_last =~ ^[0-9]+$ ]] || seed_last=0          # horodatage abîmé : on retente
  seed_now=$(date +%s)
  if (( seed_now - seed_last >= ${AIKIT_SEED_RETRY_SECS:-600} )); then
    mkdir -p "$AIKIT_CACHE" && printf '%s\n' "$seed_now" > "$AIKIT_SEED_STAMP"
    notify "$(t first_run)"
    command -v aikit-sync >/dev/null && aikit-sync --repos --force >/dev/null 2>&1 || true
    if db_empty; then
      notify "$(t first_run_failed)"
    else
      rm -f "$AIKIT_SEED_STAMP"   # amorcée : une base vidée plus tard repart aussitôt
    fi
  fi
fi

# --- parcours : dépôt d'abord, skill ensuite --------------------------------
skill=${1-}; shift 2>/dev/null || true
SKILL_ARGS=("$@")          # arguments passés à la skill en ligne de commande

case "$skill" in
  auto-dev|implement-issue|merge-pr|create-issue|triage-backlog|setup-repo|get-repo-profile) gh_only=github ;;
  *) gh_only="" ;;
esac

run_skill() { # <dépôt> <nwo> <skill> -> 1 si l'utilisateur revient en arrière
  local repo="$1" nwo="$2" skill="$3" n idea eligible_note state_slug prompt

  case "$skill" in
    auto-dev)
      eligible_note=""; ((ELIGIBLE > 0)) && eligible_note=$(t agents_eligible "$ELIGIBLE")
      n=$(ask "$(t agents_prompt "$eligible_note")") || return 1
      n=${n:-3}
      mkdir -p "$AIKIT_STATE_DIR"
      state_slug=$(session_base "$repo" "$nwo"); state_slug=${state_slug#aikit-}
      launch "auto-dev · $n agents" "$repo" \
        "$(t autodev_prompt "$n" "$AIKIT_STATE_DIR/$state_slug.md")"
      ;;
    implement-issue)
      n=$(pick_number "$repo" "$nwo" issues "$(t issue_prompt)") || return 1
      [[ -n $n && $n != __back ]] || return 1
      launch "implement-issue #$n" "$repo" "/ai-migration-kit:implement-issue $n"
      ;;
    merge-pr)
      n=$(pick_number "$repo" "$nwo" prs "$(t pr_prompt)") || return 1
      [[ -n $n && $n != __back ]] || return 1
      launch "merge-pr #$n" "$repo" "/ai-migration-kit:merge-pr $n"
      ;;
    create-issue)
      idea=$(ask "$(t idea_prompt)") || return 1
      [[ -n $idea ]] || return 1
      launch "create-issue" "$repo" "/ai-migration-kit:create-issue $idea"
      ;;
    *)
      prompt="/ai-migration-kit:$skill ${SKILL_ARGS[*]-}"
      launch "$skill" "$repo" "${prompt% }"
      ;;
  esac
}

# Échap (ou la ligne « retour ») remonte d'un cran au lieu de tout annuler.
while :; do
  repo=$(pick_repo "$gh_only") || exit 0
  [[ -n $repo && -d $repo ]] || exit 0

  nwo=$(nwo_of "$repo")
  freshen "$nwo" "$repo"
  counts_of "$nwo"

  if [[ -n $skill ]]; then                 # skill imposée en argument
    run_skill "$repo" "$nwo" "$skill" || exit 0
    exit 0
  fi

  while :; do
    chosen=$(pick_skill "$repo" "$nwo") || break
    [[ -n $chosen && $chosen != __back ]] || break
    [[ $chosen == __attach* ]] && attach_session "${chosen#__attach|}"
    run_skill "$repo" "$nwo" "$chosen" || continue
  done
done
